rules_version = '2';

// ============================================================
// O.HOME Storage 보안 규칙 (이미지·파일)
// Firebase 콘솔 → Storage → 규칙 에 붙여넣고 [게시].
//   · 읽기는 공개 (방문자가 그림을 봐야 하므로)
//   · 올리기·지우기는 로그인 회원만
//   · 한 번에 20MB 초과 업로드 차단
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /ohome/{allPaths=**} {
      allow read: if true;
      // 올리기: 로그인 회원 + 20MB 이하 + 소유자 표식(owner)을 자기 uid로
      allow create: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.metadata.owner == request.auth.uid;
      // 덮어쓰기: 파일 주인만
      allow update: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && resource.metadata.owner == request.auth.uid;
      // 지우기: 파일 주인만 (임의 회원이 남의 파일을 지우던 구멍 수정)
      allow delete: if request.auth != null
        && resource.metadata.owner == request.auth.uid;
    }
  }
}
